# Preferred: python3 scripts/setup_db.py generates .env with random passwords.
# Passwords below are placeholders; use URL-safe hex passwords for migration DSN.
MYSQL_PORT=3307
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
# Host Go process. For a Go container in this Compose network use mysql:3306.
MYSQL_DSN=drift_app:REPLACE_WITH_RANDOM_HEX@tcp(127.0.0.1:3307)/drift_bottle?charset=utf8mb4&parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27&timeout=5s&readTimeout=10s&writeTimeout=10s

# Required for both processes. Inject a random 32+ byte value through the environment.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
# Railway injects PORT; leave HTTP_ADDR unset there.
AUTH_ISSUER=drift-bottle
AUTH_AUDIENCE=drift-bottle-web
AUTH_SIGNING_KEY=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_KEY
CORS_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins for additional Vercel preview domains.
# CORS_ORIGINS=https://preview.example.com,https://another-preview.example.com
# AI endpoint implementing POST <AI_BASE_URL>/chat/completions; do not use Zhihu Zhida.
AI_BASE_URL=https://YOUR_MODEL_PROVIDER/v1
AI_MODEL=YOUR_MODEL_NAME
# AI_API_KEY is injected at runtime.
# Zhihu public App ID and registered callback; secrets are injected at runtime.
ZHIHU_OAUTH_APP_ID=YOUR_APP_ID
ZHIHU_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/integrations/zhihu/callback
ZHIHU_SEARCH_DAILY_BUDGET=500
ACTIVE_BOTTLE_LIMIT=3
# Required only for Zhihu: ZHIHU_ACCESS_SECRET, ZHIHU_OAUTH_APP_KEY,
# ZHIHU_TOKEN_ENCRYPTION_KEY (base64 encoding of 32 random bytes).
